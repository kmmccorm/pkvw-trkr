# Copy to .env and fill in. .env is gitignored.
# On the Pi this lives at /etc/pkvw-trkr.env instead (systemd EnvironmentFile).
CTA_API_KEY=your_25_character_key_here
PORT=3000

# All numeric settings are validated at startup; a bad value exits with a
# one-line message rather than starting in a broken state.
# PORT: 1-65535   MAX_ROWS: 1-50   WINDOW_START_HOUR: 0-23   WINDOW_END_HOUR: 1-24
# WINDOW_DAYS: ISO weekdays 1-7, Monday = 1   TZ_NAME: an IANA zone

# Development only - widen the service window so the table renders at any hour.
# Leave these unset in production.
# WINDOW_START_HOUR=0
# WINDOW_END_HOUR=24
# WINDOW_DAYS=1,2,3,4,5,6,7
